{
  "name": "glob-discovery",
  "prompt": "Find every .md file in this project using the Glob tool, then reply with just the count of files you found.",
  "setup": [
    {
      "path": "README.md",
      "content": "# demo"
    },
    {
      "path": "docs/a.md",
      "content": "a"
    },
    {
      "path": "docs/b.md",
      "content": "b"
    },
    {
      "path": "src/main.ts",
      "content": "export {};"
    }
  ],
  "expect": {
    "toolUsed": "Glob",
    "outputMatches": "\\b3\\b",
    "maxTurns": 10
  }
}
