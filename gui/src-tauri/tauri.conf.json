{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vexa Code",
  "version": "1.0.0",
  "identifier": "com.vexa.code",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist-gui"
  },
  "app": {
    "windows": [
      {
        "title": "Vexa Code",
        "width": 1000,
        "height": 700,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/node.exe",
      "resources/vexa-cli.cjs"
    ]
  }
}